APP_NAME=Handlelista
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Origin for links in e-mails when the web app is served elsewhere (defaults to APP_URL).
FRONTEND_URL=

# The mobile app needs a public Passport client. Create it once per environment:
#   php artisan passport:client --public --name="Food App Mobile" --redirect_uri="foodapp://oauth/callback"
# put the printed client id in food-app-expo/.env as EXPO_PUBLIC_OAUTH_CLIENT_ID, and mark it as
# trusted so it skips the consent screen (untrusted clients are treated as third-party/MCP apps):
#   php artisan oauth:trust-client <client-id>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live sync: `reverb` in production (Laravel Cloud WebSockets fills in the REVERB_* values).
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
# Only when devices reach the socket at a different address than the server does.
# REVERB_PUBLIC_HOST=
FILESYSTEM_DISK=local
# Disk for dinner pictures; use s3 (with AWS_URL set to the bucket's public/CDN URL) in production.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Server-side AI assistance (users must also opt in). Daily budgets reset at 00:00 UTC.
AI_ENABLED=false
OPENROUTER_API_KEY=
AI_CLASSIFICATION_MODEL=typesafe/jev-1.13
AI_SUGGESTION_MODEL=google/gemini-3.1-flash-lite
# Defaults only; admins can change models and reasoning effort under /admin/ai.
AI_SUGGESTION_REASONING=minimal
AI_CLASSIFICATIONS_PER_USER=100
AI_CLASSIFICATIONS_PER_HOUSEHOLD=300
AI_CLASSIFICATIONS_GLOBAL=5000
AI_SUGGESTIONS_PER_USER=20
AI_SUGGESTIONS_PER_HOUSEHOLD=60
AI_SUGGESTIONS_GLOBAL=1000
AI_WEEK_PLANS_PER_IP=20
AI_WEEK_PLANS_GLOBAL=200
AI_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
AI_IMAGE_DAILY_BUDGET=2
AI_IMAGES_PER_USER=10
AI_IMAGES_PER_HOUSEHOLD=20
AI_IMAGES_GLOBAL=500

# "Continue with Google" (Google Cloud Console OAuth client, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to /auth/google/callback on APP_URL.
GOOGLE_REDIRECT_URI=

# Sign in with Apple in the iOS app. APPLE_CLIENT_ID is the app's bundle id.
APPLE_CLIENT_ID=no.handlelistaapp
# Optional Sign in with Apple key, so deleting an account revokes it at Apple.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 file's contents on one line, with \n for line breaks.
APPLE_PRIVATE_KEY=
